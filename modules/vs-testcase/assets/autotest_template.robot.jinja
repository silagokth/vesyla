*** Settings ***
Library           Process
Library           OperatingSystem
Library           String
Suite Teardown    Terminate All Processes    kill=True
Test Template     Autotest Template

*** Variables ***
# Keep every testcase's work directory, not only the failing ones'.
# Set with `--variable NO_CLEANUP:True` (run.sh --no-cleanup).
${NO_CLEANUP}     ${False}
# Build every testcase's RTL without reconfiguration.
# Set with `--variable NO_RECONFIGURATION:True` (run.sh --no-reconfiguration).
${NO_RECONFIGURATION}    ${False}

*** Test Cases ***  testcase_path    frontend
{% for testcase in testcases %}
{{ testcase.name }}    {{ testcase.path }}    {{ testcase.frontend }}
    [Tags]    {{ testcase.tags }}    frontend:{{ testcase.frontend }}
{% endfor %}

*** Keywords ***
Autotest Template
    [Arguments]    ${testcase_path}    ${frontend}
    ${random_string} =    Generate Random String    12    [LOWER]
    ${testcase_name} =    Set Variable    ${TEST_NAME}
    # Clean the testcase name so it can be safely used as a directory name by replacing any character
    # that is not a letter, digit, underscore, or hyphen with an underscore.
    ${clean_testcase_name} =    Replace String Using Regexp    ${testcase_name}    [^a-zA-Z0-9_-]    _
    ${output_dir} =    Set Variable    work/${clean_testcase_name}_${random_string}
    Create Directory    ${output_dir}
    ${reconf_flag} =    Set Variable If    ${NO_RECONFIGURATION}    --no-reconfiguration    ${EMPTY}

    ${result} =    Run Process    vesyla testcase run -d "${testcase_path}" --frontend ${frontend} ${reconf_flag}    shell=True    timeout=30 min    stdout=stdout.txt    stderr=stderr.txt    cwd=${output_dir}
    Report Cycles    ${output_dir}

    Verify Setup            ${result.rc}    ${output_dir}
    Verify Compile          ${result.rc}    ${output_dir}
    Verify Schedule Exists  ${result.rc}    ${output_dir}
    Verify Schedule Found   ${result.rc}    ${output_dir}
    Verify Model 2 Run      ${result.rc}    ${output_dir}
    Verify Model 2 Output   ${result.rc}    ${output_dir}
    Verify RTL Run          ${result.rc}    ${output_dir}
    Verify RTL Output       ${result.rc}    ${output_dir}
    Verify Exit Code        ${result.rc}    ${output_dir}
    # A failing testcase stops at its Verify step above and keeps its directory.
    IF    not ${NO_CLEANUP}
        Remove Directory    ${output_dir}    recursive=True
    END

# The cycle counts the testcase's run.sh wrote to work/cycles.txt (sst, rtl and,
# without reconfiguration, start_offset), as the test's message: the report
# shows them and run.sh lists them after the suite. A failing step replaces it.
Report Cycles
    [Arguments]    ${output_dir}
    ${cycles_file} =    Set Variable    ${output_dir}/work/cycles.txt
    ${has_cycles} =    Run Keyword And Return Status    File Should Exist    ${cycles_file}
    IF    ${has_cycles}
        ${cycles} =    Get File    ${cycles_file}
        ${cycles} =    Replace String    ${cycles.strip()}    \n    ${SPACE}
        Set Test Message    Cycles: ${cycles}
    END

Verify Setup
    [Arguments]    ${rc}    ${output_dir}
    Run Keyword If    ${rc} == 1    Log Failed Test Output    ${output_dir}
    Should Not Be Equal As Integers    ${rc}    1    Setup failed

Verify Compile
    [Arguments]    ${rc}    ${output_dir}
    Run Keyword If    ${rc} == 6    Log Failed Test Output    ${output_dir}
    Should Not Be Equal As Integers    ${rc}    6    Compilation failed

Verify Schedule Exists
    [Arguments]    ${rc}    ${output_dir}
    Run Keyword If    ${rc} == 7    Log Failed Test Output    ${output_dir}
    Should Not Be Equal As Integers    ${rc}    7    No schedule exists (timing constraints are infeasible)

Verify Schedule Found
    [Arguments]    ${rc}    ${output_dir}
    Run Keyword If    ${rc} == 8    Log Failed Test Output    ${output_dir}
    Should Not Be Equal As Integers    ${rc}    8    Scheduler gave up (solver time or memory limit)

Verify Model 2 Run
    [Arguments]    ${rc}    ${output_dir}
    Run Keyword If    ${rc} == 2    Log Failed Test Output    ${output_dir}
    Should Not Be Equal As Integers    ${rc}    2    Model 2 (SST) failed to run

Verify Model 2 Output
    [Arguments]    ${rc}    ${output_dir}
    Run Keyword If    ${rc} == 3    Log Failed Test Output    ${output_dir}
    Should Not Be Equal As Integers    ${rc}    3    Model 2 (SST) output mismatch vs model_0

Verify RTL Run
    [Arguments]    ${rc}    ${output_dir}
    Run Keyword If    ${rc} == 4    Log Failed Test Output    ${output_dir}
    Should Not Be Equal As Integers    ${rc}    4    RTL simulation crashed

Verify RTL Output
    [Arguments]    ${rc}    ${output_dir}
    Run Keyword If    ${rc} == 5    Log Failed Test Output    ${output_dir}
    Should Not Be Equal As Integers    ${rc}    5    RTL output mismatch vs model_0

Verify Exit Code
    [Arguments]    ${rc}    ${output_dir}
    Run Keyword If    ${rc} != 0    Log Failed Test Output    ${output_dir}
    Should Be Equal As Integers    ${rc}    0    Unknown failure (rc=${rc})

Log Failed Test Output
    [Arguments]    ${output_dir}
    ${stdout} =    Get File    ${output_dir}/stdout.txt
    ${stderr} =    Get File    ${output_dir}/stderr.txt
    Log    \n===== STDOUT =====\n${stdout}\n===== STDERR =====\n${stderr}    console=True
